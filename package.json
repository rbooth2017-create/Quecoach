{
  "name": "cue-coach",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/dev-app-name.mjs",
    "test": "node --test \"test/*.test.mjs\"",
    "start": "python3 -m http.server 8642",
    "helper": ".venv/bin/python helper/rekordbox_helper.py",
    "test:helper": ".venv/bin/python -m unittest helper/test_helper.py",
    "desktop": "electron .",
    "build:helper": ".venv/bin/python helper/build_helper.py",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:linux": "electron-builder --linux --publish never"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.1"
  },
  "main": "desktop/main.cjs",
  "version": "0.2.0",
  "description": "DJ coaching side panel for rekordbox",
  "author": "Cue Coach",
  "build": {
    "appId": "app.cuecoach.desktop",
    "productName": "Cue Coach",
    "files": [
      "index.html",
      "spike.html",
      "learn.html",
      "js/**",
      "desktop/**",
      "package.json",
      "assets/**"
    ],
    "extraResources": [
      {
        "from": "dist-helper/cuecoach-helper",
        "to": "helper"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.music",
      "icon": "assets/icon.png"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Audio",
      "maintainer": "Cue Coach",
      "icon": "assets/icon.png"
    },
    "asarUnpack": [
      "node_modules/tesseract.js/**",
      "node_modules/tesseract.js-core/**",
      "node_modules/@tesseract.js-data/**"
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.11.0",
    "@tesseract.js-data/eng": "1.0.0",
    "signalsmith-stretch": "1.3.2",
    "tesseract.js": "7.0.0"
  }
}
